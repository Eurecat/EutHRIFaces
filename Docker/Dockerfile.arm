# EutHRIFaces — Jetson Thor / ARM64 image
#
# Builds on top of the EutRobAIDockers ARM base image (ROS 2 Jazzy + PyTorch ARM64).
# Build the base first:
#   cd EutRobAIDockers/Docker && ./build_container.sh --platform arm
# Then build this image:
#   ./build_container.sh --arm
#
# Build context is the EutHRIFaces repo root (one level above Docker/),
# so Docker can COPY the ROS 2 package directories directly.
# On Jetson Thor the NVIDIA PyTorch base already ships torch + CUDA, so
# there is no /opt/ros_python_env venv — packages are installed via system pip.
#
ARG BASE_IMAGE="eut_ros_torch:jazzy"

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG PLATFORM_ARCH="arm"

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-rosdep \
    python3-colcon-common-extensions \
    python3-vcstool \
    build-essential \
    git \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# ------------------------------------------------------------
# Python deps (ARM-specific, no pip CUDA stack — NVIDIA base has it)
# The NVIDIA Jetson PyTorch base ships a Debian-managed `blinker` without
# a pip RECORD file, which can block installs. Force-overwrite first.
#
# IMPORTANT — torch preservation:
# The NGC base ships torch as a pre-release (e.g. 2.8.0a0+nv25.08, CUDA 13.0).
# pip's dependency resolution prefers the latest *stable* PyPI release, so
# installing `facenet-pytorch` (which requires torch>=1.0.0) would silently
# downgrade torch to the latest CPU-only PyPI stable release (e.g. 2.2.2).
# Fix: install facenet-pytorch with --no-deps; all its non-torch deps
# (numpy, Pillow, requests, tqdm) are already present in the base or in
# the rest of requirements_arm_thor.txt.
# ------------------------------------------------------------
COPY Docker/requirements_arm_thor.txt /workspace/requirements_arm_thor.txt
RUN pip install --no-cache-dir --ignore-installed blinker && \
    grep -v "^facenet-pytorch" /workspace/requirements_arm_thor.txt > /tmp/req_no_facenet.txt && \
    pip install --no-cache-dir -r /tmp/req_no_facenet.txt && \
    pip install --no-cache-dir --no-deps "facenet-pytorch>=2.5.2"

# ------------------------------------------------------------
# GPU-capable onnxruntime (TensorrtExecutionProvider / CUDAExecutionProvider)
# The standard PyPI onnxruntime has no aarch64 GPU wheels.
# Try the Microsoft CUDA 13 ORT feed; falls back gracefully to the CPU
# version installed from requirements_arm_thor.txt above.
# Alternative: NVIDIA JetPack wheel for JetPack 6+:
#   pip install onnxruntime-gpu --extra-index-url \
#     https://developer.download.nvidia.com/compute/redist/jp/v61/onnxruntime/

# 2. ORT SM mismatch — CUDAExecutionProvider installed (from Microsoft CUDA 13 feed) but compiled for x86 SM targets, not Jetson Thor SM 11.0. Probe fallback to CPU correct behavior. True GPU ORT needs build from source with CUDA_ARCH=SM_110 — no prebuilt wheel exists for JetPack 7.0 yet. Per CONTEXT.md, check when dusty-nv/jetson-containers publishes r38.x images for GPU ORT wheel. Face detection on CPU at 55-85ms still functional.

# ------------------------------------------------------------
RUN pip install --no-cache-dir onnxruntime-gpu \
        --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-13/pypi/simple/ \
    && echo "[OK] onnxruntime-gpu installed (GPU providers available)" \
    || echo "[WARN] onnxruntime-gpu not available for this platform/CUDA version; using CPU-only onnxruntime"

# ------------------------------------------------------------
# rosdep setup
# ------------------------------------------------------------
RUN [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ] && \
    /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && rosdep init" || \
    echo "rosdep already initialized"
RUN apt-get update && \
    /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && rosdep update"

# ------------------------------------------------------------
# Copy ROS 2 packages (build context = EutHRIFaces repo root)
# ------------------------------------------------------------
COPY face_detection           /workspace/src/face_detection
COPY face_recognition         /workspace/src/face_recognition
COPY gaze_estimation          /workspace/src/gaze_estimation
COPY visual_speech_activity   /workspace/src/visual_speech_activity
COPY Docker/deps/hri_msgs     /workspace/src/hri_msgs

# ------------------------------------------------------------
# Pre-bake MediaPipe face_landmarker.task into the image.
# Avoids runtime download failures from partial/corrupted files.
# Float16 variant (~5.5 MB). Verify size > 1 MB to catch partial fetches.
# ------------------------------------------------------------
RUN mkdir -p /workspace/src/face_detection/weights && \
    curl -fL "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task" \
         -o /workspace/src/face_detection/weights/face_landmarker.task && \
    python3 -c "\
import os, sys; \
size = os.path.getsize('/workspace/src/face_detection/weights/face_landmarker.task'); \
print(f'face_landmarker.task: {size} bytes'); \
sys.exit(0 if size > 1*1024*1024 else 1)"

# ------------------------------------------------------------
# Install ROS dependencies from package.xmls
# ------------------------------------------------------------
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    rosdep install --from-paths src --ignore-src -r -y"

# ------------------------------------------------------------
# Build workspace
# ------------------------------------------------------------
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --base-paths /workspace/src \
        --build-base  /workspace/build \
        --install-base /workspace/install \
        --event-handlers console_direct+ \
        --symlink-install"

# Copy coverage and test scripts
COPY Docker/ci_cd_coverage.sh /ci_cd_coverage.sh
RUN chmod +x /ci_cd_coverage.sh

COPY Docker/quick_test_coverage.sh /quick_test_coverage.sh
RUN chmod +x /quick_test_coverage.sh

# Copy and set up the entrypoint script
COPY Docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
