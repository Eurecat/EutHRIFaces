# EutHRIFaces — Jetson Thor / Orin ARM64 image
#
# Builds on top of the EutRobAIDockers ARM base image (ROS 2 Jazzy + PyTorch ARM64).
# Build the base first:
#   cd EutRobAIDockers/Docker && ./build_container.sh --platform arm
# Then build this image:
#   ./build_container.sh --arm
#
# Build context is the EutHRIFaces repo root (one level above Docker/),
# so Docker can COPY the ROS 2 package directories directly.
# On Jetson Thor the NVIDIA PyTorch base already ships torch + CUDA, so
# there is no /opt/ros_python_env venv — packages are installed via system pip.
#
ARG BASE_IMAGE="eut_ros_torch:jazzy"

# ------------------------------------------------------------
# Face mesh landmark network as ONNX, for landmark_backend "facemesh_onnx" (batched on the GPU,
# ~15 ms for 5 faces) instead of the MediaPipe CPU fallback. Same steps as
# face_detection/tools/convert_face_landmarks_to_onnx.sh, in a throwaway stage so TensorFlow
# never reaches the runtime image. The ONNX graph is not device specific (Thor and Orin).
# ------------------------------------------------------------
FROM python:3.12-slim AS facemesh_onnx
ARG FACE_LANDMARKER_URL="https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task"
RUN pip install --no-cache-dir "tensorflow==2.21.0" "tf2onnx==1.17.0" && \
    mkdir -p /out && cd /tmp && \
    python -c "import urllib.request, zipfile; urllib.request.urlretrieve('${FACE_LANDMARKER_URL}', 'face_landmarker.task'); zipfile.ZipFile('face_landmarker.task').extract('face_landmarks_detector.tflite', '.')" && \
    python -m tf2onnx.convert --tflite face_landmarks_detector.tflite --output /out/face_landmarks_detector.onnx --opset 17 && \
    python -c "import os; s = os.path.getsize('/out/face_landmarks_detector.onnx'); print('face_landmarks_detector.onnx', s, 'bytes'); assert s > 1_000_000"

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG PLATFORM_ARCH="arm"

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-rosdep \
    python3-colcon-common-extensions \
    python3-vcstool \
    build-essential \
    git \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# ------------------------------------------------------------
# Python deps (ARM-specific, no pip CUDA stack — NVIDIA base has it)
# The NVIDIA Jetson PyTorch base ships a Debian-managed `blinker` without
# a pip RECORD file, which can block installs. Force-overwrite first.
#
# IMPORTANT — torch preservation:
# The NGC base ships torch as a pre-release (e.g. 2.8.0a0+nv25.08, CUDA 13.0).
# pip's dependency resolution prefers the latest *stable* PyPI release, so
# installing `facenet-pytorch` (which requires torch>=1.0.0) would silently
# downgrade torch to the latest CPU-only PyPI stable release (e.g. 2.2.2).
# Fix: install facenet-pytorch with --no-deps; all its non-torch deps
# (numpy, Pillow, requests, tqdm) are already present in the base or in
# the rest of requirements_arm_thor.txt.
# ------------------------------------------------------------
COPY Docker/requirements_arm_thor.txt /workspace/requirements_arm_thor.txt
RUN pip install --no-cache-dir --ignore-installed blinker && \
    grep -v "^facenet-pytorch" /workspace/requirements_arm_thor.txt > /tmp/req_no_facenet.txt && \
    pip install --no-cache-dir -r /tmp/req_no_facenet.txt \
        $([ -f /opt/jetson_constraints.txt ] && echo "-c /opt/jetson_constraints.txt") && \
    pip install --no-cache-dir --no-deps "facenet-pytorch>=2.5.2"

# ------------------------------------------------------------
# GPU-capable onnxruntime (CUDAExecutionProvider) — Jetson Thor / sbsa aarch64
# Official NVIDIA wheel for JetPack 7 / CUDA 13.0, Python 3.12:
#   https://pypi.jetson-ai-lab.io/sbsa/cu130
# This wheel is compiled with the correct SM targets for Jetson Thor (SM 10+)
# and replaces any CPU-only onnxruntime installed earlier.
# SHA-256 is embedded in the URL fragment for pip verification.
# ------------------------------------------------------------
RUN if [ "${JETSON_TARGET:-thor}" = "thor" ]; then \
    pip install --no-cache-dir --force-reinstall \
    "https://pypi.jetson-ai-lab.io/sbsa/cu130/+f/012/c10bef23a39f0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl#sha256=012c10bef23a39f074730d158b72f797a7314f2695c65835a0669b57282422f6" \
    && echo "[OK] onnxruntime-gpu 1.24.0 (sbsa/cu130) installed" \
    || echo "[WARN] onnxruntime-gpu Jetson wheel install failed; GPU inference unavailable"; \
fi

# Jetson Orin (JetPack 6): onnxruntime-gpu 1.23.0 for Python 3.12 from the jp6/cu129 feed
# (CUDA + TensorRT EPs; runs on the CUDA 12.8 Orin base). The CPU onnxruntime from the
# requirements shares the onnxruntime/ package dir, so remove it first (its other deps
# stay; coloredlogs is the one the CPU wheel no longer pulls in), and fail the
# build if CUDAExecutionProvider is missing instead of silently running on CPU.
ARG ORT_GPU_WHEEL_ORIN="https://pypi.jetson-ai-lab.io/jp6/cu129/+f/2e3/a07114007df15/onnxruntime_gpu-1.23.0-cp312-cp312-linux_aarch64.whl#sha256=2e3a07114007df15db673852d798d6f47f91362f0ac084d6fa04e414a06dc25e"
RUN if [ "${JETSON_TARGET:-thor}" = "orin" ]; then \
    pip uninstall -y onnxruntime onnxruntime-gpu \
    && pip install --no-cache-dir --no-deps "${ORT_GPU_WHEEL_ORIN}" \
    && pip install --no-cache-dir coloredlogs \
    && python3 -c "import onnxruntime as o; p = o.get_available_providers(); print(o.__version__, p); assert 'CUDAExecutionProvider' in p"; \
fi

# onnxruntime-gpu 1.24.0 pulls in numpy>=2 as a transitive dep, but cv_bridge
# and the NGC PyTorch wheel are compiled against NumPy 1.x ABI. Downgrade numpy.
# protobuf: mediapipe>=0.10.14 needs 4.x (uses GetMessageClass); the GetPrototype
# warning from ROS tools is non-fatal. Allow 4.x, block 5.x+ until tested.
RUN pip install --no-cache-dir "numpy>=1.26,<2" "protobuf>=4.21,<5"

# The entrypoint injects /opt/ros_python_env/lib/python3.12/site-packages into
# sys.path first, so any CPU-only onnxruntime installed there shadows the system
# GPU wheel. Install the GPU wheel + version pins into the venv as well.
# On Orin /opt/ros_python_env is the venv pip already installed into, so skip it there.
RUN if [ -d /opt/ros_python_env/bin ] && [ "${JETSON_TARGET:-thor}" = "thor" ]; then \
    /opt/ros_python_env/bin/pip install --no-cache-dir --force-reinstall \
        "https://pypi.jetson-ai-lab.io/sbsa/cu130/+f/012/c10bef23a39f0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl#sha256=012c10bef23a39f074730d158b72f797a7314f2695c65835a0669b57282422f6" \
    && /opt/ros_python_env/bin/pip install --no-cache-dir "numpy>=1.26,<2" "protobuf>=4.21,<5" \
    && echo "[OK] onnxruntime-gpu + pins applied to /opt/ros_python_env"; \
fi

# ------------------------------------------------------------
# rosdep setup
# ------------------------------------------------------------
RUN [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ] && \
    /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && rosdep init" || \
    echo "rosdep already initialized"
RUN apt-get update && \
    /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && rosdep update"

# ------------------------------------------------------------
# Copy ROS 2 packages (build context = EutHRIFaces repo root)
# ------------------------------------------------------------
COPY face_detection           /workspace/src/face_detection
COPY face_recognition         /workspace/src/face_recognition
COPY gaze_estimation          /workspace/src/gaze_estimation
COPY visual_speech_activity   /workspace/src/visual_speech_activity
COPY Docker/deps/hri_msgs     /workspace/src/hri_msgs

# ------------------------------------------------------------
# Pre-bake MediaPipe face_landmarker.task into the image.
# Stored at /opt/mediapipe_weights/ so it survives dev-mode src volume mounts
# that shadow /workspace/src/face_detection/weights/.
# The entrypoint restores it to the src path if the copy there is missing/corrupt.
# Float16 variant (~5.5 MB). Verify size > 1 MB to catch partial fetches.
# ------------------------------------------------------------
RUN mkdir -p /opt/mediapipe_weights && \
    curl -fL "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task" \
         -o /opt/mediapipe_weights/face_landmarker.task && \
    python3 -c "\
import os, sys; \
size = os.path.getsize('/opt/mediapipe_weights/face_landmarker.task'); \
print(f'face_landmarker.task: {size} bytes'); \
sys.exit(0 if size > 1*1024*1024 else 1)"
COPY --from=facemesh_onnx /out/face_landmarks_detector.onnx /opt/mediapipe_weights/face_landmarks_detector.onnx

# ------------------------------------------------------------
# Install ROS dependencies from package.xmls
# ------------------------------------------------------------
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    rosdep install --from-paths src --ignore-src -r -y"

# ------------------------------------------------------------
# Build workspace
# ------------------------------------------------------------
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --base-paths /workspace/src \
        --build-base  /workspace/build \
        --install-base /workspace/install \
        --event-handlers console_direct+ \
        --symlink-install"

# Copy coverage and test scripts
COPY Docker/ci_cd_coverage.sh /ci_cd_coverage.sh
RUN chmod +x /ci_cd_coverage.sh

COPY Docker/quick_test_coverage.sh /quick_test_coverage.sh
RUN chmod +x /quick_test_coverage.sh

# Copy and set up the entrypoint script
COPY Docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
