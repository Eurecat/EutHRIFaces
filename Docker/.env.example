# Environment variables for EutHRIFaces Docker container
# This file is automatically managed by build_container.sh

# Docker image name (set automatically by build script)
BUILT_IMAGE=eut_hri_faces:jazzy-vulcanexus

# Your PC-ROS setup
DOCKER_RUNTIME=nvidia
ROS_DOMAIN_ID=12
# RMW_IMPLEMENTATION=...

# TIAGo Pro over WiFi settings
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp #rmw_fastrtps_cpp

# User configuration (uncomment and set if needed)
# USER_ID=1000
# GROUP_ID=1000
# USERNAME=coghri

# ROS configuration
# ROS_DOMAIN_ID=0

# Audio configuration (uncomment if needed)
# ALSA_CARD=0

# GPU configuration (uncomment if using NVIDIA GPU)
# NVIDIA_VISIBLE_DEVICES=all

# Log retention: number of log sessions to keep on each container start.
# Use -1 to never delete logs, or any positive integer (e.g. 2, 10).
BUILD_LOGS_TO_KEEP=2
RUNTIME_LOGS_TO_KEEP=2


# echo $LD_LIBRARY_PATH #for humble 3.10 jazzy 3.12
# /workspace/install/hri_msgs/lib:/opt/ros/humble/opt/rviz_ogre_vendor/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib:/opt/ros_python_env/lib/python3.10/site-packages/nvidia/cudnn/lib:/opt/ros_python_env/lib/python3.10/site-packages/nvidia/cublas/lib:/opt/ros_python_env/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:

# Local-only credentials for Docker Hub integration.
# This file is ignored by git via .gitignore.

DOCKERHUB_ORG=eurecatrobotica
DOCKERHUB_USERNAME=dockerrobadmin
DOCKERHUB_TOKEN=

DOCKERHUB_REPO_PREFIX=
DOCKERHUB_PULL_FIRST=true
DOCKERHUB_PUSH_AFTER_BUILD=false
